{
  "name": "alpharesin",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/sdk",
    "packages/engine",
    "packages/resin"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/sdk && tsc -p packages/engine && tsc -p packages/resin && tsc -p packages/resin/playground",
