//@version=6
// AlphaResin conformance 2: trend, volume, pivots, other timeframes and Heikin Ashi.
// Add the Volume indicator before exporting.
indicator("AlphaResin Conformance 2 | AlphaPine", overlay = true)

[st, stDir] = ta.supertrend(3, 10)
plot(st, "supertrend")
plot(stDir, "supertrend dir")
plot(ta.sar(0.02, 0.02, 0.2), "sar")
plot(ta.vwap, "vwap")
[vw, vwUp, vwLow] = ta.vwap(hlc3, timeframe.change("W"), 1)
plot(vw, "vwap weekly")
plot(vwUp, "vwap weekly upper")
plot(vwLow, "vwap weekly lower")
plot(ta.obv, "obv")
plot(ta.accdist, "accdist")
plot(ta.pvt, "pvt")
plot(ta.pvi, "pvi")
plot(ta.nvi, "nvi")
plot(ta.wad, "wad")
plot(ta.iii, "iii")
plot(ta.wvad, "wvad")
plot(ta.correlation(close, volume, 20), "correlation")
plot(ta.max(high), "max")
plot(ta.min(low), "min")
cross = ta.crossover(close, ta.sma(close, 20))
plot(ta.barssince(cross), "barssince")
plot(ta.valuewhen(cross, close, 1), "valuewhen")
plot(ta.pivothigh(high, 5, 5), "pivothigh")
plot(ta.pivotlow(low, 5, 5), "pivotlow")
plot(ta.crossunder(close, ta.sma(close, 20)) ? 1 : 0, "crossunder")
plot(ta.rising(close, 3) ? 1 : 0, "rising")
plot(ta.falling(close, 3) ? 1 : 0, "falling")

newDay = timeframe.change("D")
trad = ta.pivot_point_levels("Traditional", newDay)
fib = ta.pivot_point_levels("Fibonacci", newDay)
wood = ta.pivot_point_levels("Woodie", newDay)
clas = ta.pivot_point_levels("Classic", newDay)
dm = ta.pivot_point_levels("DM", newDay)
cam = ta.pivot_point_levels("Camarilla", newDay)
plot(trad.get(0), "traditional P")
plot(trad.get(5), "traditional R3")
plot(trad.get(10), "traditional S5")
plot(fib.get(0), "fibonacci P")
plot(fib.get(3), "fibonacci R2")
plot(wood.get(0), "woodie P")
plot(wood.get(7), "woodie R4")
plot(clas.get(0), "classic P")
plot(clas.get(8), "classic S4")
plot(dm.get(0), "dm P")
plot(dm.get(1), "dm R1")
plot(cam.get(0), "camarilla P")
plot(cam.get(7), "camarilla R4")
plot(cam.get(9), "camarilla R5")

plot(request.security(syminfo.tickerid, "D", close), "D close")
plot(request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on), "D prev close")
plot(request.security(syminfo.tickerid, "W", ta.ema(close, 5)), "W ema")
plot(request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close), "HA close")
plot(dayofweek, "dayofweek")
plot(time("D"), "time D")
