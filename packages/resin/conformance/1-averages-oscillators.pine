//@version=6
// AlphaResin conformance 1: averages, oscillators and volatility. Each plot is one
// built-in on the chart's own bars; AlphaResin runs the same script on the export
// and compares every column. Add the Volume indicator before exporting.
indicator("AlphaResin Conformance 1 | AlphaPine", overlay = false)

len = 14
plot(ta.sma(close, len), "sma")
plot(ta.ema(close, len), "ema")
plot(ta.rma(close, len), "rma")
plot(ta.wma(close, len), "wma")
plot(ta.hma(close, len), "hma")
plot(ta.alma(close, 9, 0.85, 6), "alma")
plot(ta.alma(close, 9, 0.85, 6, true), "alma floor")
plot(ta.vwma(close, len), "vwma")
plot(ta.swma(close), "swma")
plot(ta.linreg(close, len, 0), "linreg")
plot(ta.median(close, len), "median")
plot(ta.stdev(close, len), "stdev")
plot(ta.stdev(close, len, false), "stdev unbiased")
plot(ta.dev(close, len), "dev")
plot(ta.variance(close, len), "variance")
plot(ta.percentrank(close, len), "percentrank")
plot(ta.percentile_linear_interpolation(close, len, 30), "percentile linear")
plot(ta.percentile_nearest_rank(close, len, 30), "percentile nearest")
plot(ta.mode(math.round(close / 100) * 100, len), "mode")
plot(ta.cmo(close, len), "cmo")
plot(ta.mom(close, len), "mom")
plot(ta.roc(close, len), "roc")
plot(ta.rsi(close, len), "rsi")
plot(ta.cci(close, 20), "cci")
plot(ta.mfi(hlc3, len), "mfi")
plot(ta.wpr(len), "wpr")
plot(ta.tsi(close, 13, 25), "tsi")
plot(ta.rci(close, 10), "rci")
plot(ta.cog(close, 10), "cog")
plot(ta.change(close), "change")
plot(ta.cum(close), "cum")
plot(ta.highest(high, len), "highest")
plot(ta.lowest(low, len), "lowest")
plot(ta.highestbars(high, len), "highestbars")
plot(ta.lowestbars(low, len), "lowestbars")
plot(ta.range(close, len), "range")
plot(ta.atr(len), "atr")
plot(ta.tr, "tr")
plot(ta.tr(true), "tr handle na")
[bbMid, bbUp, bbLow] = ta.bb(close, 20, 2)
plot(bbMid, "bb basis")
plot(bbUp, "bb upper")
plot(bbLow, "bb lower")
plot(ta.bbw(close, 20, 2), "bbw")
[kcMid, kcUp, kcLow] = ta.kc(close, 20, 1.5)
plot(kcMid, "kc basis")
plot(kcUp, "kc upper")
plot(kcLow, "kc lower")
plot(ta.kcw(close, 20, 1.5), "kcw")
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
plot(macdLine, "macd")
plot(signalLine, "macd signal")
plot(histLine, "macd hist")
plot(ta.stoch(close, high, low, len), "stoch")
[diPlus, diMinus, adx] = ta.dmi(14, 14)
plot(diPlus, "di plus")
plot(diMinus, "di minus")
plot(adx, "adx")
